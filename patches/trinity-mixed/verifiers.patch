+++ b/tests/unit/test_output_budget.py
@@ -0,0 +1,162 @@
+"""Opt-in cumulative output limits at the actual model-request boundary."""
+
+import asyncio
+import json
+
+import pytest
+from aiohttp.test_utils import make_mocked_request
+
+import verifiers.v1 as vf
+from verifiers.v1.clients import ModelContext
+from verifiers.v1.clients.train import response_from_generate, serialize_completion
+from verifiers.v1.configs.client import EvalClientConfig
+from verifiers.v1.dialects.chat import ChatDialect
+from verifiers.v1.interception.server import InterceptionServer
+from verifiers.v1.session import RolloutLimits, RolloutSession
+
+
+class RecordingClient:
+    def __init__(self, outputs):
+        self.outputs = iter(outputs)
+        self.requests = []
+
+    async def get_response(self, dialect, body, sampling, **kwargs):
+        self.requests.append((body, sampling))
+        await asyncio.sleep(0)
+        count = min(next(self.outputs), sampling.max_tokens)
+        turn = kwargs["turn"]
+        prefix = [
+            token
+            for node in turn.prefix_node_ids
+            for token in turn.trace.nodes[node].token_ids
+        ]
+        response = response_from_generate(
+            {
+                "prompt_ids": prefix + [1],
+                "completion_ids": [2] * count,
+                "completion_logprobs": [-0.1] * count,
+                "content": "answer",
+                "reasoning_content": "reasoning",
+                "finish_reason": "stop",
+            },
+            "policy",
+        )
+        response.raw = serialize_completion(response, "policy")
+        return response
+
+
+def make_session(outputs, *, strict=True, budget=32768, cap=32768):
+    config = vf.AgentConfig(max_output_tokens=budget, strict_output_token_budget=strict)
+    trace = vf.Trace(
+        agent=vf.AgentInfo(config=config),
+        task=vf.TraceTask(type="Task", data=vf.TaskData(idx=0, prompt="hello")),
+    )
+    client = RecordingClient(outputs)
+    session = RolloutSession(
+        ctx=ModelContext(
+            model="policy",
+            client=EvalClientConfig(),
+            sampling=vf.SamplingConfig(max_tokens=cap, temperature=0.7, top_k=20),
+        ),
+        trace=trace,
+        limits=RolloutLimits(
+            max_output_tokens=budget, strict_output_token_budget=strict
+        ),
+        client=client,
+    )
+    server = InterceptionServer()
+    server.sessions["secret"] = session
+    return server, session, client
+
+
+async def request(server, turn, cap=32768, messages=None):
+    req = make_mocked_request(
+        "POST", "/v1/chat/completions", headers={"Authorization": "Bearer secret"}
+    )
+    req._read_bytes = json.dumps(
+        {
+            "model": "policy",
+            "messages": messages or [{"role": "user", "content": f"branch {turn}"}],
+            "max_completion_tokens": cap,
+        }
+    ).encode()
+    return await server.handle_request(req, ChatDialect())
+
+
+@pytest.mark.parametrize("outputs", [[20000, 20000], [10000, 10000, 20000]])
+async def test_cumulative_budget_caps_native_requests(outputs):
+    server, session, client = make_session(outputs)
+    used = 0
+    messages = []
+    for turn, output in enumerate(outputs):
+        messages.append({"role": "user", "content": f"turn {turn}"})
+        response = await request(server, turn, messages=messages)
+        assert response.status == 200
+        messages.append(json.loads(response.body)["choices"][0]["message"])
+        body, sampling = client.requests[-1]
+        assert body["max_tokens"] == sampling.max_tokens == 32768 - used
+        assert "max_completion_tokens" not in body
+        assert sampling.temperature == 0.7 and sampling.top_k == 20
+        used += min(output, sampling.max_tokens)
+    assert session.trace.num_output_tokens == 32768
+    assert (await request(server, "exhausted")).status == 400
+    assert len(client.requests) == len(outputs)
+    assert session.trace.stop_condition == "max_output_tokens"
+    assert session.ctx.sampling.max_tokens == 32768
+    # Native completion ids include reasoning; preserve tokens and their logprobs.
+    assert session.trace.last_reply == "answer"
+    assert session.trace.num_branches == 1
+    assert all(
+        n.message.reasoning_content == "reasoning"
+        for n in session.trace.nodes
+        if n.sampled
+    )
+    assert all(len(b.logprobs) == len(b.token_ids) for b in session.trace.branches)
+    assert sum(sum(n.mask) for n in session.trace.nodes) == 32768
+    assert all(
+        n.logprobs == [-0.1] * sum(n.mask) for n in session.trace.nodes if n.sampled
+    )
+
+
+@pytest.mark.parametrize(
+    "cap,source,expected", [(1024, 32768, 1024), (32768, 512, 512)]
+)
+async def test_lower_client_or_source_request_cap_is_preserved(cap, source, expected):
+    server, session, client = make_session([32768], cap=cap)
+    assert (await request(server, 0, cap=source)).status == 200
+    assert client.requests[0][0]["max_tokens"] == expected
+    assert client.requests[0][1].max_tokens == expected
+    assert session.trace.num_output_tokens == expected
+
+
+async def test_zero_budget_does_not_generate():
+    server, session, client = make_session([], budget=0)
+    assert (await request(server, 0)).status == 400
+    assert client.requests == []
+    assert session.trace.stop_condition == "max_output_tokens"
+
+
+async def test_default_soft_budget_still_allows_crossing_response():
+    assert vf.AgentConfig().strict_output_token_budget is False
+    server, session, client = make_session([20000, 20000], strict=False)
+    for turn in range(2):
+        assert (await request(server, turn)).status == 200
+    assert [s.max_tokens for _, s in client.requests] == [32768, 32768]
+    assert session.trace.num_output_tokens == 40000
+
+
+async def test_parallel_branches_share_budget():
+    server, session, client = make_session([20000, 20000])
+    responses = await asyncio.gather(request(server, 0), request(server, 1))
+    assert [r.status for r in responses] == [200, 200]
+    assert [s.max_tokens for _, s in client.requests] == [32768, 12768]
+    assert session.trace.num_output_tokens == 32768
+
+
+async def test_other_agent_session_has_its_own_budget():
+    policy, policy_session, _ = make_session([32768])
+    judge, judge_session, _ = make_session([100], strict=False)
+    assert (await request(policy, 0)).status == 200
+    assert (await request(judge, 0)).status == 200
+    assert policy_session.trace.num_output_tokens == 32768
+    assert judge_session.trace.num_output_tokens == 100
