@@ -0,0 +1,301 @@
+"""Hermes parsing against Trinity's pinned tokenizer and actual template."""
+
+import asyncio
+import json
+
+import pytest
+from transformers.tokenization_utils_fast import PreTrainedTokenizerFast
+
+from renderers import DefaultRendererConfig, create_renderer
+from renderers.base import (
+    RenderedConversation,
+    ToolCallParseStatus,
+    build_training_sample,
+)
+from renderers.parsers import get_tool_parser
+
+
+@pytest.fixture(scope="module")
+def trinity():
+    return PreTrainedTokenizerFast.from_pretrained(
+        "arcee-ai/Trinity-Mini",
+        revision="cdb81e8130815fec299cccc8f8700004b8366e1e",
+    )
+
+
+def encode(tok, text):
+    return tok.encode(text, add_special_tokens=False)
+
+
+def test_hermes_template_roundtrip_and_training_mask(trinity):
+    renderer = create_renderer(
+        trinity, DefaultRendererConfig(tool_parser="hermes", reasoning_parser="think")
+    )
+    messages = [
+        {"role": "user", "content": "search"},
+        {
+            "role": "assistant",
+            "content": "",
+            "tool_calls": [
+                {
+                    "id": "call_a",
+                    "type": "function",
+                    "function": {"name": "search", "arguments": '{"q":"rain"}'},
+                },
+                {
+                    "id": "call_b",
+                    "type": "function",
+                    "function": {"name": "lookup", "arguments": '{"n":2}'},
+                },
+            ],
+        },
+    ]
+    full = renderer.render_ids(messages)
+    prompt = encode(
+        trinity,
+        trinity.apply_chat_template(messages[:1], tokenize=False)
+        + "<|im_start|>assistant\n",
+    )
+    split = next(
+        (i for i, (a, b) in enumerate(zip(prompt, full)) if a != b), len(prompt)
+    )
+    prompt = full[:split]
+    completion = full[split:]
+    original = list(completion)
+    parsed = renderer.parse_response(completion)
+    assert [(tc.name, tc.arguments, tc.status, tc.id) for tc in parsed.tool_calls] == [
+        ("search", {"q": "rain"}, ToolCallParseStatus.OK, None),
+        ("lookup", {"n": 2}, ToolCallParseStatus.OK, None),
+    ]
+    # The template does not carry wire IDs; callers allocate those IDs.
+    rebuilt = dict(
+        messages[1],
+        tool_calls=[
+            {
+                "type": "function",
+                "function": {"name": tc.name, "arguments": json.dumps(tc.arguments)},
+            }
+            for tc in parsed.tool_calls
+        ],
+    )
+    assert renderer.render_ids([messages[0], rebuilt]) == full
+    logprobs = [-i / 100 for i in range(len(completion))]
+    state = RenderedConversation(prompt_ids=prompt).with_completion(
+        completion, completion_logprobs=logprobs, parsed_completion=parsed
+    )
+    assert state.token_ids == full
+    assert state.completion_logprobs == logprobs
+    sample = build_training_sample(
+        renderer, messages, role_to_mask=lambda m: m["role"] == "assistant"
+    )
+    assert sample.token_ids == full
+    user_length = len(renderer.render_ids(messages[:1]))
+    assert sample.loss_mask == [False] * user_length + [True] * (
+        len(full) - user_length
+    )
+    assert len(sample.loss_mask) == len(full)
+    assert all(sample.loss_mask[len(prompt) :])
+    assert completion == original
+
+
+@pytest.mark.parametrize(
+    "prefix,suffix", [("before\n", "\nafter"), ("x", "tail"), ("", "\n")]
+)
+def test_hermes_merged_boundaries_and_interleaved_text(trinity, prefix, suffix):
+    renderer = create_renderer(
+        trinity, DefaultRendererConfig(tool_parser="hermes", reasoning_parser="think")
+    )
+    first = '<tool_call>{"name":"f","arguments":{"s":"</tool_call><tool_call>"}}</tool_call>'
+    second = '<tool_call>\n{"name":"g","arguments":{}}\n</tool_call>'
+    text = prefix + first + " middle " + second + suffix
+    ids = encode(trinity, text)
+    parsed = renderer.parse_response(ids)
+    assert parsed.content == prefix + " middle " + suffix
+    assert [tc.name for tc in parsed.tool_calls] == ["f", "g"]
+    assert all(tc.status == ToolCallParseStatus.OK for tc in parsed.tool_calls)
+    assert parsed.tool_calls[0].arguments == {"s": "</tool_call><tool_call>"}
+    for tc, block in zip(parsed.tool_calls, [first, second]):
+        start, end = tc.token_span
+        assert block in trinity.decode(ids[start:end])
+        # Selective masks index the emitted stream, including merged boundary tokens.
+        mask = [True] * len(ids)
+        mask[start:end] = [False] * (end - start)
+        assert len(mask) == len(ids)
+        assert sum(not value for value in mask) == end - start
+
+
+@pytest.mark.parametrize(
+    "body,status",
+    [
+        ('{"name":"f","arguments":{}}', ToolCallParseStatus.OK),
+        ("{broken", ToolCallParseStatus.INVALID_JSON),
+        ('{"arguments":{}}', ToolCallParseStatus.MISSING_NAME),
+        ('{"name":23,"arguments":{}}', ToolCallParseStatus.MISSING_NAME),
+        ('{"name":"f","arguments":[]}', ToolCallParseStatus.MALFORMED_STRUCTURE),
+    ],
+)
+def test_hermes_attempt_status(trinity, body, status):
+    parser = get_tool_parser("hermes", trinity)
+    ids = encode(trinity, "<tool_call>\n" + body + "\n</tool_call>")
+    content, calls = parser.extract(ids)
+    assert content == []
+    assert len(calls) == 1
+    assert calls[0].status == status
+    if status != ToolCallParseStatus.OK:
+        assert calls[0].name is None
+    assert calls[0].token_span == (0, len(ids))
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "plain reply",
+        "Use <tool_call> and </tool_call> tags.",
+        "<tool_cal",
+        "</tool_call>",
+        "<tool_call>...",
+    ],
+)
+def test_hermes_literal_and_partial_tags(trinity, text):
+    ids = encode(trinity, text)
+    assert get_tool_parser("hermes", trinity).extract(ids) == (ids, [])
+
+
+def test_hermes_reasoning_unclosed_and_no_tools(trinity):
+    renderer = create_renderer(
+        trinity, DefaultRendererConfig(tool_parser="hermes", reasoning_parser="think")
+    )
+    plain = '<think>consider <tool_call>{"name":"literal"}</tool_call></think>reply'
+    parsed = renderer.parse_response(encode(trinity, plain), tools=None)
+    assert parsed.content == "reply"
+    assert (
+        parsed.reasoning_content == 'consider <tool_call>{"name":"literal"}</tool_call>'
+    )
+    assert parsed.tool_calls == []
+    text = '<think>reason</think>before<tool_call>{"name":"f"}</tool_cal'
+    ids = encode(trinity, text)
+    parsed = renderer.parse_response(ids)
+    assert parsed.reasoning_content == "reason"
+    assert parsed.content == "before"
+    assert parsed.tool_calls[0].status == ToolCallParseStatus.UNCLOSED_BLOCK
+    start, end = parsed.tool_calls[0].token_span
+    assert "<tool_call>" in trinity.decode(ids[start:end])
+    assert end == len(ids)
+    prompt = encode(trinity, "<|im_start|>assistant\n<think>\n")
+    parsed = renderer.parse_response(
+        encode(trinity, "reason</think>reply"), prompt_ids=prompt
+    )
+    assert parsed.reasoning_content == "reason"
+    assert parsed.content == "reply"
+
+
+@pytest.mark.parametrize("text", ["<tool_call>", "<tool_call>\n"])
+def test_hermes_empty_unclosed_attempt(trinity, text):
+    ids = encode(trinity, text)
+    content, calls = get_tool_parser("hermes", trinity).extract(ids)
+    assert content == []
+    assert calls[0].status == ToolCallParseStatus.UNCLOSED_BLOCK
+    assert calls[0].token_span == (0, len(ids))
+
+
+def test_hermes_native_generate_then_tool_result(trinity):
+    asyncio.run(_hermes_native_generate_then_tool_result(trinity))
+
+
+async def _hermes_native_generate_then_tool_result(trinity):
+    from test_client import _FakeClient
+
+    from renderers.client import generate
+
+    renderer = create_renderer(
+        trinity, DefaultRendererConfig(tool_parser="hermes", reasoning_parser="think")
+    )
+    tools = [
+        {
+            "type": "function",
+            "function": {
+                "name": "search",
+                "parameters": {"type": "object", "properties": {}},
+            },
+        }
+    ]
+    messages = [{"role": "user", "content": "search"}]
+    completion = encode(
+        trinity,
+        'reason</think>\n<tool_call>\n{"name": "search", "arguments": {}}\n</tool_call><|im_end|>',
+    )
+    logprobs = [-i / 100 for i in range(len(completion))]
+    client = _FakeClient()
+    client.choice.update(
+        token_ids=completion,
+        logprobs={
+            "content": [
+                {"token": f"token_id:{token}", "logprob": logprob}
+                for token, logprob in zip(completion, logprobs)
+            ]
+        },
+    )
+    first = await generate(
+        client=client,
+        renderer=renderer,
+        messages=messages,
+        tools=tools,
+        model="trinity",
+        max_prompt_len=10000,
+    )
+    assert first["completion_ids"] == completion
+    assert first["completion_logprobs"] == logprobs
+    assert first["reasoning_content"] == "reason"
+    assert first["finish_reason"] == "tool_calls"
+    call = first["tool_calls"][0]
+    assert call.name == "search"
+    assistant = {
+        "role": "assistant",
+        "content": first["content"],
+        "reasoning_content": first["reasoning_content"],
+        "tool_calls": [
+            {
+                "id": "call_0",
+                "type": "function",
+                "function": {
+                    "name": call.name,
+                    "arguments": json.dumps(call.arguments),
+                },
+            }
+        ],
+    }
+    tail = [{"role": "tool", "tool_call_id": "call_0", "content": "found"}]
+    assert (
+        renderer.bridge_to_next_turn(first["prompt_ids"], completion, tail, tools=tools)
+        is None
+    )
+    client.choice.update(token_ids=encode(trinity, "done</think>reply<|im_end|>"))
+    client.choice["logprobs"] = {
+        "content": [
+            {"token": f"token_id:{token}", "logprob": -0.1}
+            for token in client.choice["token_ids"]
+        ]
+    }
+    second = await generate(
+        client=client,
+        renderer=renderer,
+        messages=messages + [assistant] + tail,
+        tools=tools,
+        model="trinity",
+        max_prompt_len=10000,
+    )
+    prior = first["prompt_ids"] + completion
+    prefix = next(
+        (i for i, (a, b) in enumerate(zip(prior, second["prompt_ids"])) if a != b),
+        min(len(prior), len(second["prompt_ids"])),
+    )
+    # The opaque template strips historical reasoning: native fallback must
+    # retain each turn as its own sampled segment, not claim a shared prefix.
+    assert prefix < len(first["prompt_ids"])
+    assert first["completion_ids"] == completion
+    assert first["completion_logprobs"] == logprobs
+    assert second["content"] == "reply"
+    assert second["prompt_attribution"].sampled_mask == []
+    print(
+        f"native first_prompt={len(first['prompt_ids'])} completion={len(completion)} next_prompt={len(second['prompt_ids'])} shared_prefix={prefix}"
+    )
