+class HermesToolParser:
+    """Hermes JSON with ordinary, potentially merged delimiter tokens.
+
+    An opener followed by a JSON object or end of output starts an attempt;
+    mentions of the tag in prose stay literal. Text sharing a token with a delimiter is
+    retained by ``extract_text``. Spans cover whole original sampled tokens.
+    """
+
+    def __init__(self, tokenizer):
+        self._tokenizer = tokenizer
+
+    def extract_text(self, ids: list[int]) -> tuple[str, list[ParsedToolCall]]:
+        text = _decode(self._tokenizer, ids)
+        starts = list(re.finditer(r"<tool_call>\s*(?=\{|$)", text))
+        if not starts:
+            return text, []
+        offsets = _infer_offsets_from_decode(self._tokenizer, ids, text)
+        if offsets is None:
+            raise ValueError("Hermes parser cannot map decoded text to sampled tokens")
+        content: list[str] = []
+        calls: list[ParsedToolCall] = []
+        cursor = 0
+        decoder = json.JSONDecoder()
+        for match in starts:
+            if match.start() < cursor:
+                continue
+            payload_start = match.end()
+            parsed = None
+            try:
+                parsed, payload_end = decoder.raw_decode(text, payload_start)
+            except json.JSONDecodeError:
+                payload_end = payload_start
+            # A valid JSON string may itself contain either delimiter.
+            close = text.find("</tool_call>", payload_end)
+            end = len(text) if close == -1 else close + len("</tool_call>")
+            raw = text[payload_start : close if close != -1 else len(text)].strip()
+            name = parsed.get("name") if isinstance(parsed, dict) else None
+            arguments = (
+                parsed.get("arguments", {}) if isinstance(parsed, dict) else None
+            )
+            if close == -1:
+                status = ToolCallParseStatus.UNCLOSED_BLOCK
+            elif parsed is None or text[payload_end:close].strip():
+                status = ToolCallParseStatus.INVALID_JSON
+            elif not isinstance(name, str) or not name:
+                status = ToolCallParseStatus.MISSING_NAME
+            elif not isinstance(arguments, dict):
+                status = ToolCallParseStatus.MALFORMED_STRUCTURE
+            else:
+                status = ToolCallParseStatus.OK
+            start_token = next(
+                i for i, (_, b) in enumerate(offsets) if b > match.start()
+            )
+            end_token = next(
+                (i for i, (a, _) in enumerate(offsets) if a >= end), len(ids)
+            )
+            calls.append(
+                ParsedToolCall(
+                    raw=raw,
+                    name=name if status == ToolCallParseStatus.OK else None,
+                    arguments=arguments,
+                    token_span=(start_token, end_token),
+                    status=status,
+                )
+            )
+            content.append(text[cursor : match.start()])
+            cursor = end
+        content.append(text[cursor:])
+        return "".join(content), calls
+
+    def extract(self, ids: list[int]) -> tuple[list[int], list[ParsedToolCall]]:
+        """Remove whole tokens intersecting calls; never re-encode sampled IDs."""
+        _, calls = self.extract_text(ids)
+        content_ids: list[int] = []
+        cursor = 0
+        for call in calls:
+            assert call.token_span is not None
+            start, end = call.token_span
+            content_ids.extend(ids[cursor:start])
+            cursor = end
+        content_ids.extend(ids[cursor:])
+        return content_ids, calls
+
+
