+fn build_models_request(
+    client: &reqwest::Client,
+    url: &str,
+    api_key: Option<&str>,
+) -> Result<reqwest::RequestBuilder, reqwest::header::InvalidHeaderValue> {
+    let request = client.get(url).timeout(std::time::Duration::from_secs(5));
+
+    let Some(api_key) = api_key.filter(|key| !key.is_empty()) else {
+        return Ok(request);
+    };
+
+    let mut authorization = reqwest::header::HeaderValue::from_str(&format!("Bearer {api_key}"))?;
+    authorization.set_sensitive(true);
+
+    Ok(request.header(reqwest::header::AUTHORIZATION, authorization))
+}
