+fn send_error_class(error: &reqwest::Error) -> &'static str {
+    if error.is_timeout() {
+        "timeout"
+    } else if error.is_connect() {
+        "connect"
+    } else if error.is_builder() {
+        "builder"
+    } else if error.is_redirect() {
+        "redirect"
+    } else if error.is_body() {
+        "body"
+    } else if error.is_decode() {
+        "decode"
+    } else if error.is_request() {
+        "request"
+    } else {
+        "other"
+    }
+}
+
+// Limit both traversal and formatting. Unknown source text can contain request data.
+fn send_error_causes(error: &(dyn std::error::Error + 'static)) -> (String, bool) {
+    use std::fmt::Write;
+
+    struct CauseText(String);
+    impl std::fmt::Write for CauseText {
+        fn write_str(&mut self, value: &str) -> std::fmt::Result {
+            if self.0.len() + value.len() > 256 {
+                return Err(std::fmt::Error);
+            }
+            self.0.push_str(value);
+            Ok(())
+        }
+    }
+
+    let mut causes = String::new();
+    let mut source = error.source();
+    for _ in 0..8 {
+        let Some(cause) = source else { break };
+        if !causes.is_empty() {
+            causes.push_str(" -> ");
+        }
+        if let Some(io) = cause.downcast_ref::<std::io::Error>() {
+            // ErrorKind and the OS code contain no custom error message.
+            write!(causes, "io:{:?}:os={:?}", io.kind(), io.raw_os_error()).unwrap();
+        } else {
+            let mut text = CauseText(String::new());
+            let complete = write!(text, "{cause}").is_ok();
+            let label = if complete {
+                match text.0.as_str() {
+                    "connection closed before message completed" => "incomplete_message",
+                    "operation was canceled" | "operation canceled" => "canceled",
+                    "channel closed" => "channel_closed",
+                    "connection error" => "connection_error",
+                    "client error (Connect)" | "tcp connect error" => "connect",
+                    "operation timed out" => "timeout",
+                    "http2 error" => "http2",
+                    value if value.starts_with("dns error") => "dns",
+                    value if value.starts_with("invalid peer certificate") => "tls_certificate",
+                    _ => "unclassified",
+                }
+            } else {
+                "unclassified"
+            };
+            causes.push_str(label);
+        }
+        source = cause.source();
+    }
+    (causes, source.is_some())
+}
+
+fn send_error_worker_origin(worker_url: &str) -> String {
+    reqwest::Url::parse(worker_url)
+        .map(|url| {
+            url.origin()
+                .ascii_serialization()
+                .chars()
+                .take(256)
+                .collect()
+        })
+        .unwrap_or_else(|_| "invalid_url".to_string())
+}
+
+fn log_typed_send_error(error: &reqwest::Error, worker_url: &str, elapsed: Duration) {
+    let (causes, causes_truncated) = send_error_causes(error);
+    error!(
+        worker_origin = %send_error_worker_origin(worker_url),
+        error_class = send_error_class(error),
+        is_connect = error.is_connect(),
+        is_timeout = error.is_timeout(),
+        error_causes = %causes,
+        causes_truncated,
+        send_elapsed_ms = elapsed.as_secs_f64() * 1000.0,
+        "Failed to send typed request"
+    );
+}
