+def _is_fastokens_incompatible(
+    model_name_or_path: str,
+    load_name_or_path: str,
+) -> bool:
+    if (
+        model_name_or_path in FASTOKENS_INCOMPATIBLE
+        or load_name_or_path in FASTOKENS_INCOMPATIBLE
+    ):
+        return True
+
+    tokenizer_json = Path(load_name_or_path) / "tokenizer.json"
+    if not tokenizer_json.is_file():
+        return False
+    try:
+        text = tokenizer_json.read_text(encoding="utf-8")
+        return '"type":"Digits"' in text or '"type": "Digits"' in text
+    except OSError:
+        return False
+
