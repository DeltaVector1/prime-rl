+
+
+@pytest.mark.asyncio
+async def test_overlong_prompt_before_first_step_sets_error(
+    mock_client, sample_chat_dataset, make_input
+):
+    """First-turn prompt overlength should not look like an empty success."""
+
+    class PromptTooLongEnv(MultiTurnEnv):
+        async def env_response(self, messages, state, **kwargs):  # type: ignore[override]
+            return [{"role": "user", "content": "Continue"}]
+
+    env = PromptTooLongEnv(
+        client=mock_client,
+        model="test-model",
+        dataset=sample_chat_dataset,
+        parser=Parser(),
+        rubric=Rubric(),
+        max_turns=1,
+    )
+    mock_client.get_response = AsyncMock(
+        side_effect=vf.OverlongPromptError("too long")
+    )
+
+    state = await env.rollout(
+        input=make_input(
+            prompt=[{"role": "user", "content": "Start conversation"}],
+            answer="target_answer",
+        ),
+        client=mock_client,
+        model="test-model",
+    )
+
+    assert state["prompt_too_long"] is True
+    assert state["is_truncated"] is True
+    assert state["stop_condition"] == "prompt_too_long"
+    assert state["trajectory"] == []
+    assert state["completion"] == []
+    assert isinstance(state["error"], vf.OverlongPromptError)
